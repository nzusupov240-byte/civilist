# ------------------------------------------------------------------
# Переменные окружения для обработчика заявок
# Скопируйте этот файл в .env.local и заполните нужные значения,
# затем раскомментируйте соответствующий блок в
# src/app/api/application/route.ts
# ------------------------------------------------------------------

# --- Telegram-бот ---
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789

# --- Произвольный webhook (Make, n8n, CRM и т.п.) ---
# APPLICATION_WEBHOOK_URL=https://example.com/webhook

# --- Email (например, через Resend) ---
# RESEND_API_KEY=re_...
# APPLICATION_EMAIL_TO=info@civilist.kg
